    <string name="ui_fragment_bmi_text_4" formatted="false">Calculate BMI</string>
    <string name="ui_fragment_bmi_hint_5" formatted="false">BMI Result</string>
    <string name="ui_fragment_contact_us_text_0" formatted="false">Project information\n\nDietPal is a coursework portfolio project. Build instructions, supported features and validation details are included in the repository README.\n\nThis demo does not operate a customer-support service.</string>
