<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardBackgroundColor="@color/white"
    android:elevation="8dp"
    android:layout_margin="4dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <ImageView
            android:id="@+id/ImageView_instructions_step_items"
            android:scaleType="center"
            android:layout_width="100dp"
            android:layout_height="60dp" android:importantForAccessibility="no"/>


        <TextView
            android:id="@+id/textView_instructions_step_item"
            android:text="@string/ui_list_instructions_step_items_text_0"
            android:textStyle="bold|italic"
            android:textSize="18sp"
            android:textAlignment="center"
            android:textColor="#B10000"
            android:padding="4dp"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:ellipsize="marquee"
            android:scrollHorizontally="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>




    </LinearLayout>

</androidx.cardview.widget.CardView>