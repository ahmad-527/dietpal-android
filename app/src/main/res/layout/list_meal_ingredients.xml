<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#B10000"
    app:cardElevation="8dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView_ingredients_quantity"
            android:text="@string/ui_list_meal_ingredients_text_0"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:textColor="#B10000"
            android:textAlignment="center"
            android:textSize="16sp"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/imageView_ingredients"
            android:scaleType="center"
            android:layout_width="80dp"
            android:layout_height="50dp" android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/textView_ingredients_name"
            android:text="@string/ui_list_meal_ingredients_text_1"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:textSize="16sp"
            android:textAlignment="center"
            android:textColor="#B10000"
            android:padding="4dp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>





    </LinearLayout>

</androidx.cardview.widget.CardView>