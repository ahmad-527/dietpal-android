<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/heart">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CALCULATE YOU BODY MASS INDEX !"
        android:id="@+id/titleBMI"
        android:textSize="20dp"
        android:textColor="@color/white"
        android:textStyle="bold|italic"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/BMIh1"
        android:layout_below="@+id/titleBMI"
        android:text="Get to know your body better"
        android:layout_centerHorizontal="true"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:textStyle="italic"/>

    <EditText
        android:textColor="@color/white"
        android:padding="10dp"
        android:id="@+id/editTextWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Weight (kg)"
        android:textColorHint="#7AFFFFFF"
        android:inputType="numberDecimal"
        android:layout_marginBottom="100dp"
        android:layout_marginTop="220dp"
        android:textSize="25dp"
        android:textStyle="italic"
        android:background="@drawable/input_bg"
        />

    <EditText
        android:textColor="@color/white"
        android:padding="10dp"
        android:id="@+id/editTextHeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Height (cm)"
        android:background="@drawable/input_bg"
        android:textColorHint="#7AFFFFFF"
        android:inputType="numberDecimal"
        android:textSize="25dp"
        android:textStyle="italic"
        android:layout_below="@id/editTextWeight"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculate BMI"
        android:textSize="25dp"
        android:textStyle="bold|italic"
        android:layout_below="@id/editTextHeight"
        android:layout_marginTop="16dp"
        android:backgroundTint="#B10000"/>

    <TextView
        android:textColor="@color/white"
        android:padding="10dp"
        android:id="@+id/textViewResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:hint="BMI Result"
        android:textColorHint="#7AFFFFFF"
        android:layout_below="@id/btnCalculate"
        android:textStyle="italic"
        android:textSize="25dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/input_bg"
        />

</RelativeLayout>